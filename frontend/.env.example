# Copy this file to .env.local and fill in the values you have.
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser — never put a
# secret key here, only publishable/client keys.

# Your backend API (see backend/.env — PORT)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# https://dashboard.stripe.com/test/apikeys — the PUBLISHABLE key, not the secret one
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# https://console.cloud.google.com/google/maps-apis — enable "Maps JavaScript API"
# Without this, the map on the car details page falls back to a plain address line.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
