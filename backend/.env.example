# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
# Local:   mongodb://127.0.0.1:27017/vroomly
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/vroomly
MONGO_URI=mongodb://127.0.0.1:27017/vroomly

# ── Auth ──────────────────────────────────────────────────
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRE=7d

# ── Frontend origin (for CORS) ───────────────────────────────
CLIENT_URL=http://localhost:3000

# ── Cloudinary (image uploads) ───────────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Stripe (payments) ─────────────────────────────────────
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DEFAULT_CURRENCY=usd

# ── Business rules ────────────────────────────────────────
# Percentage Vroomly keeps from every completed, paid booking
PLATFORM_COMMISSION_PERCENT=12
